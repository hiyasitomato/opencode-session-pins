+import { describe, expect, test } from "bun:test"
+import type { ServerConnection } from "@/runtime/server/registry"
+import {
+  INITIAL_HOME_PIN_SYNC_STATE,
+  transitionHomePinSync,
+  type HomePinSyncEvent,
+  type HomePinSyncState,
+} from "./pin-sync-machine"
+
+// SAFETY: a server key is an opaque branded string; the tests only need distinct values.
+const serverKey = (name: string) => name as ServerConnection.Key
+
+const SERVER_A = serverKey("http:a")
+
+const SERVER_B = serverKey("http:b")
+
+function step(state: HomePinSyncState, event: HomePinSyncEvent) {
+  return transitionHomePinSync(state, event)
+}
+
+describe("home pin sync machine", () => {
+  test("loads pins on connect and applies live remote updates when idle", () => {
+    const loading = step(INITIAL_HOME_PIN_SYNC_STATE, { type: "server.changed", server: SERVER_A, connected: true })
+    expect(loading.state).toMatchObject({ status: "loading", attempt: 1, server: SERVER_A })
+    expect(loading.effects).toEqual([{ type: "fetch", attempt: 1, server: SERVER_A }])
+
+    const ready = step(loading.state, {
+      type: "fetch.succeeded",
+      attempt: 1,
+      pins: ["ses_1"],
+      localPins: [],
+      synced: false,
+    })
+
+    expect(ready.state).toMatchObject({ status: "ready", server: SERVER_A, inFlight: undefined, queue: [] })
+    expect(ready.effects).toEqual([{ type: "apply", server: SERVER_A, pins: ["ses_1"], markSynced: true }])
+
+    const remote = step(ready.state, { type: "remote.updated", server: SERVER_A, pins: ["ses_1", "ses_2"] })
+    expect(remote.state).toBe(ready.state)
+    expect(remote.effects).toEqual([{ type: "apply", server: SERVER_A, pins: ["ses_1", "ses_2"], markSynced: true }])
+  })
+
+  test("migrates pre-existing unsynced local pins once when server is empty, without resurrecting cleared pins", () => {
+    const loading = step(INITIAL_HOME_PIN_SYNC_STATE, { type: "server.changed", server: SERVER_A, connected: true })
+
+    // Unsynced local pins upload sequentially.
+    const migrating = step(loading.state, {
+      type: "fetch.succeeded",
+      attempt: 1,
+      pins: [],
+      localPins: ["ses_a", "ses_b"],
+      synced: false,
+    })
+
+    expect(migrating.effects).toEqual([
+      { type: "mark.synced", server: SERVER_A },
+      { type: "mutate", attempt: 2, server: SERVER_A, mutation: { op: "pin", sessionId: "ses_a" } },
+    ])
+
+    const second = step(migrating.state, { type: "mutation.succeeded", attempt: 2, pins: ["ses_a"] })
+    expect(second.effects).toEqual([
+      { type: "mutate", attempt: 3, server: SERVER_A, mutation: { op: "pin", sessionId: "ses_b" } },
+    ])
+
+    const done = step(second.state, { type: "mutation.succeeded", attempt: 3, pins: ["ses_a", "ses_b"] })
+    expect(done.effects).toEqual([{ type: "apply", server: SERVER_A, pins: ["ses_a", "ses_b"], markSynced: true }])
+
+    // Already-synced client receiving empty server pins clears local cache instead of re-uploading.
+    const disconnected = step(done.state, { type: "server.changed", server: SERVER_A, connected: false })
+    const reloading = step(disconnected.state, { type: "server.changed", server: SERVER_A, connected: true })
+    const attempt = reloading.state.status === "loading" ? reloading.state.attempt : -1
+
+    const cleared = step(reloading.state, {
+      type: "fetch.succeeded",
+      attempt,
+      pins: [],
+      localPins: ["ses_a", "ses_b"],
+      synced: true,
+    })
+
+    expect(cleared.effects).toEqual([{ type: "apply", server: SERVER_A, pins: [], markSynced: true }])
+  })
+
+  test("serializes mutations, coalesces repeated toggles for the same session, and defers SSE while busy", () => {
+    const loading = step(INITIAL_HOME_PIN_SYNC_STATE, { type: "server.changed", server: SERVER_A, connected: true })
+
+    const ready = step(loading.state, {
+      type: "fetch.succeeded",
+      attempt: 1,
+      pins: [],
+      localPins: [],
+      synced: true,
+    })
+
+    const m1 = step(ready.state, { type: "mutation.requested", server: SERVER_A, op: "pin", sessionId: "ses_1" })
+    expect(m1.effects).toEqual([
+      { type: "mutate", attempt: 2, server: SERVER_A, mutation: { op: "pin", sessionId: "ses_1" } },
+    ])
+
+    // While ses_1 is in flight, pin then unpin ses_2 coalesces to a single unpin.
+    const m2 = step(m1.state, { type: "mutation.requested", server: SERVER_A, op: "pin", sessionId: "ses_2" })
+    const m3 = step(m2.state, { type: "mutation.requested", server: SERVER_A, op: "unpin", sessionId: "ses_2" })
+    expect(m3.effects).toEqual([])
+
+    // Remote SSE broadcast is ignored while local mutations are still in flight.
+    const sse = step(m3.state, { type: "remote.updated", server: SERVER_A, pins: ["ses_1"] })
+    expect(sse.effects).toEqual([])
+
+    const after1 = step(m3.state, { type: "mutation.succeeded", attempt: 2, pins: ["ses_1"] })
+    expect(after1.effects).toEqual([
+      { type: "mutate", attempt: 3, server: SERVER_A, mutation: { op: "unpin", sessionId: "ses_2" } },
+    ])
+
+    const after2 = step(after1.state, { type: "mutation.succeeded", attempt: 3, pins: ["ses_1"] })
+    expect(after2.effects).toEqual([{ type: "apply", server: SERVER_A, pins: ["ses_1"], markSynced: true }])
+  })
+
+  test("falls back cleanly on unsupported servers and cancels stale attempts on server switch or dispose", () => {
+    const loadingA = step(INITIAL_HOME_PIN_SYNC_STATE, { type: "server.changed", server: SERVER_A, connected: true })
+    const unsupported = step(loadingA.state, { type: "fetch.unsupported", attempt: 1 })
+    expect(unsupported.state).toMatchObject({ status: "unsupported", server: SERVER_A })
+
+    // Further mutations on an unsupported server are no-ops.
+    const ignored = step(unsupported.state, {
+      type: "mutation.requested",
+      server: SERVER_A,
+      op: "pin",
+      sessionId: "ses_1",
+    })
+
+    expect(ignored.state).toBe(unsupported.state)
+    expect(ignored.effects).toEqual([])
+
+    // Switching to another server fetches fresh pins for the new server.
+    const loadingB = step(unsupported.state, { type: "server.changed", server: SERVER_B, connected: true })
+    expect(loadingB.state).toMatchObject({ status: "loading", attempt: 2, server: SERVER_B })
+    expect(loadingB.effects).toEqual([{ type: "fetch", attempt: 2, server: SERVER_B }])
+
+    // Stale fetch from A is ignored.
+    expect(
+      step(loadingB.state, { type: "fetch.succeeded", attempt: 1, pins: ["stale"], localPins: [], synced: true }).state,
+    ).toBe(loadingB.state)
+
+    // Dispose cancels the in-flight request.
+    const disposed = step(loadingB.state, { type: "disposed" })
+    expect(disposed.state.status).toBe("disposed")
+    expect(disposed.effects).toEqual([{ type: "fetch.cancel", attempt: 2 }])
+  })
+})
diff --git a/packages/app/src/home/sessions/pin-sync-machine.ts b/packages/app/src/home/sessions/pin-sync-machine.ts
new file mode 100644
index 0000000000..fad78363d9
--- /dev/null
+++ b/packages/app/src/home/sessions/pin-sync-machine.ts
@@ -0,0 +1,281 @@
+import type { ServerConnection } from "@/runtime/server/registry"
+
+export type HomePinMutation = {
+  readonly op: "pin" | "unpin"
+  readonly sessionId: string
+}
+
+/**
+ * Synchronizes Home session pins with the focused server.
+ *
+ * Local persistence stays the fast cache and fallback for servers that predate the pin endpoints. Once connected to a
+ * supporting server, this machine loads the server's pins, migrates pre-existing local pins once when the server has
+ * none, serializes pin/unpin mutations through one queue, and applies live SSE broadcasts when idle.
+ */
+export type HomePinSyncState =
+  | { readonly status: "idle"; readonly issued: number; readonly server: ServerConnection.Key | undefined }
+  | {
+      readonly status: "loading"
+      readonly issued: number
+      readonly attempt: number
+      readonly server: ServerConnection.Key
+      readonly queue: readonly HomePinMutation[]
+    }
+  | {
+      readonly status: "ready"
+      readonly issued: number
+      readonly server: ServerConnection.Key
+      readonly inFlight: { readonly attempt: number; readonly mutation: HomePinMutation } | undefined
+      readonly queue: readonly HomePinMutation[]
+    }
+  | { readonly status: "unsupported"; readonly issued: number; readonly server: ServerConnection.Key }
+  | { readonly status: "disposed" }
+
+export type HomePinSyncEvent =
+  | { readonly type: "server.changed"; readonly server: ServerConnection.Key | undefined; readonly connected: boolean }
+  | {
+      readonly type: "fetch.succeeded"
+      readonly attempt: number
+      readonly pins: readonly string[]
+      readonly localPins: readonly string[]
+      readonly synced: boolean
+    }
+  | { readonly type: "fetch.unsupported"; readonly attempt: number }
+  | { readonly type: "fetch.failed"; readonly attempt: number }
+  | {
+      readonly type: "mutation.requested"
+      readonly server: ServerConnection.Key
+      readonly op: "pin" | "unpin"
+      readonly sessionId: string
+    }
+  | { readonly type: "mutation.succeeded"; readonly attempt: number; readonly pins: readonly string[] }
+  | { readonly type: "mutation.unsupported"; readonly attempt: number }
+  | { readonly type: "mutation.failed"; readonly attempt: number }
+  | { readonly type: "remote.updated"; readonly server: ServerConnection.Key; readonly pins: readonly string[] }
+  | { readonly type: "disposed" }
+
+export type HomePinSyncEffect =
+  | { readonly type: "fetch.cancel"; readonly attempt: number }
+  | { readonly type: "fetch"; readonly attempt: number; readonly server: ServerConnection.Key }
+  | { readonly type: "mutate.cancel"; readonly attempt: number }
+  | {
+      readonly type: "mutate"
+      readonly attempt: number
+      readonly server: ServerConnection.Key
+      readonly mutation: HomePinMutation
+    }
+  | {
+      readonly type: "apply"
+      readonly server: ServerConnection.Key
+      readonly pins: readonly string[]
+      readonly markSynced: boolean
+    }
+  | { readonly type: "mark.synced"; readonly server: ServerConnection.Key }
+
+export type HomePinSyncTransition = {
+  readonly state: HomePinSyncState
+  readonly effects: readonly HomePinSyncEffect[]
+}
+
+const NONE: readonly HomePinSyncEffect[] = Object.freeze([])
+
+const DISPOSED: HomePinSyncState = Object.freeze({ status: "disposed" })
+
+export const INITIAL_HOME_PIN_SYNC_STATE: HomePinSyncState = Object.freeze({
+  status: "idle",
+  issued: 0,
+  server: undefined,
+})
+
+function unchanged(state: HomePinSyncState): HomePinSyncTransition {
+  return { state, effects: NONE }
+}
+
+function cancelEffects(state: HomePinSyncState): readonly HomePinSyncEffect[] {
+  if (state.status === "loading") return [{ type: "fetch.cancel", attempt: state.attempt }]
+
+  if (state.status === "ready" && state.inFlight) return [{ type: "mutate.cancel", attempt: state.inFlight.attempt }]
+
+  return NONE
+}
+
+function enqueue(queue: readonly HomePinMutation[], mutation: HomePinMutation): readonly HomePinMutation[] {
+  const next = queue.filter((item) => item.sessionId !== mutation.sessionId)
+
+  next.push(mutation)
+
+  return next
+}
+
+function mergeQueue(
+  prefix: readonly HomePinMutation[],
+  suffix: readonly HomePinMutation[],
+): readonly HomePinMutation[] {
+  let result: readonly HomePinMutation[] = []
+
+  for (const item of prefix) result = enqueue(result, item)
+
+  for (const item of suffix) result = enqueue(result, item)
+
+  return result
+}
+
+function startNextMutation(
+  issued: number,
+  server: ServerConnection.Key,
+  queue: readonly HomePinMutation[],
+  leadingEffects: readonly HomePinSyncEffect[] = NONE,
+): HomePinSyncTransition {
+  const [next, ...rest] = queue
+
+  if (!next) {
+    return {
+      state: { status: "ready", issued, server, inFlight: undefined, queue: [] },
+      effects: leadingEffects,
+    }
+  }
+
+  const attempt = issued + 1
+
+  return {
+    state: { status: "ready", issued: attempt, server, inFlight: { attempt, mutation: next }, queue: rest },
+    effects: [...leadingEffects, { type: "mutate", attempt, server, mutation: next }],
+  }
+}
+
+export function transitionHomePinSync(state: HomePinSyncState, event: HomePinSyncEvent): HomePinSyncTransition {
+  if (state.status === "disposed") return unchanged(state)
+
+  if (event.type === "disposed") return { state: DISPOSED, effects: cancelEffects(state) }
+
+  if (event.type === "server.changed") {
+    if (!event.server || !event.connected) {
+      if (state.status === "idle" && state.server === event.server) return unchanged(state)
+
+      if (state.status === "unsupported" && state.server === event.server) return unchanged(state)
+
+      return {
+        state: { status: "idle", issued: state.issued, server: event.server },
+        effects: cancelEffects(state),
+      }
+    }
+
+    if (
+      (state.status === "loading" || state.status === "ready" || state.status === "unsupported") &&
+      state.server === event.server
+    )
+      return unchanged(state)
+
+    const attempt = state.issued + 1
+
+    return {
+      state: { status: "loading", issued: attempt, attempt, server: event.server, queue: [] },
+      effects: [...cancelEffects(state), { type: "fetch", attempt, server: event.server }],
+    }
+  }
+
+  if (event.type === "fetch.succeeded") {
+    if (state.status !== "loading" || state.attempt !== event.attempt) return unchanged(state)
+
+    const shouldMigrate = event.pins.length === 0 && !event.synced && event.localPins.length > 0
+
+    if (shouldMigrate) {
+      const migration: HomePinMutation[] = event.localPins.map((sessionId) => ({ op: "pin", sessionId }))
+      const merged = mergeQueue(migration, state.queue)
+
+      return startNextMutation(state.issued, state.server, merged, [{ type: "mark.synced", server: state.server }])
+    }
+
+    if (state.queue.length > 0) {
+      return startNextMutation(state.issued, state.server, state.queue, [{ type: "mark.synced", server: state.server }])
+    }
+
+    return {
+      state: { status: "ready", issued: state.issued, server: state.server, inFlight: undefined, queue: [] },
+      effects: [{ type: "apply", server: state.server, pins: event.pins, markSynced: true }],
+    }
+  }
+
+  if (event.type === "fetch.unsupported") {
+    if (state.status !== "loading" || state.attempt !== event.attempt) return unchanged(state)
+
+    return {
+      state: { status: "unsupported", issued: state.issued, server: state.server },
+      effects: NONE,
+    }
+  }
+
+  if (event.type === "fetch.failed") {
+    if (state.status !== "loading" || state.attempt !== event.attempt) return unchanged(state)
+
+    return {
+      state: { status: "idle", issued: state.issued, server: state.server },
+      effects: NONE,
+    }
+  }
+
+  if (event.type === "mutation.requested") {
+    const mutation: HomePinMutation = { op: event.op, sessionId: event.sessionId }
+
+    if (state.status === "loading" && state.server === event.server) {
+      return {
+        state: { ...state, queue: enqueue(state.queue, mutation) },
+        effects: NONE,
+      }
+    }
+
+    if (state.status === "ready" && state.server === event.server) {
+      if (!state.inFlight) return startNextMutation(state.issued, state.server, [mutation])
+
+      return {
+        state: { ...state, queue: enqueue(state.queue, mutation) },
+        effects: NONE,
+      }
+    }
+
+    return unchanged(state)
+  }
+
+  if (event.type === "mutation.succeeded") {
+    if (state.status !== "ready" || state.inFlight?.attempt !== event.attempt) return unchanged(state)
+
+    if (state.queue.length > 0) return startNextMutation(state.issued, state.server, state.queue)
+
+    return {
+      state: { ...state, inFlight: undefined },
+      effects: [{ type: "apply", server: state.server, pins: event.pins, markSynced: true }],
+    }
+  }
+
+  if (event.type === "mutation.unsupported") {
+    if (state.status !== "ready" || state.inFlight?.attempt !== event.attempt) return unchanged(state)
+
+    return {
+      state: { status: "unsupported", issued: state.issued, server: state.server },
+      effects: NONE,
+    }
+  }
+
+  if (event.type === "mutation.failed") {
+    if (state.status !== "ready" || state.inFlight?.attempt !== event.attempt) return unchanged(state)
+
+    return startNextMutation(state.issued, state.server, state.queue)
+  }
+
+  if (event.type === "remote.updated") {
+    if (
+      state.status !== "ready" ||
+      state.server !== event.server ||
+      state.inFlight !== undefined ||
+      state.queue.length > 0
+    )
+      return unchanged(state)
+
+    return {
+      state,
+      effects: [{ type: "apply", server: state.server, pins: event.pins, markSynced: true }],
+    }
+  }
+
+  return unchanged(state)
+}
