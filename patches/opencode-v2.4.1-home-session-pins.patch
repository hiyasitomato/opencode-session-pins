+++ b/packages/server/test/home-pins.test.ts
@@ -0,0 +1,100 @@
+import { expect } from "bun:test"
+import path from "node:path"
+import { Effect } from "effect"
+import { tmpdir } from "../../core/test/fixture/tmpdir"
+import { it } from "../../core/test/lib/effect"
+import { ServerFetch } from "../src/fetch"
+
+const baseOptions = {
+  app: { version: "test-version" },
+  config: { project: false },
+  models: { fetch: false },
+  fs: { filewatcher: false },
+} as const
+
+it.live("persists Home session pins in server KV across restarts and streams updates", () =>
+  Effect.gen(function* () {
+    const dir = yield* Effect.acquireDisposable(Effect.promise(() => tmpdir("opencode-home-pins-")))
+    const dbPath = path.join(dir.path, "opencode.db")
+    const options = { ...baseOptions, database: { path: dbPath }, config: { directory: dir.path } }
+
+    const first = yield* ServerFetch.make(options)
+
+    const initial = yield* Effect.promise(() => first(new Request("http://opencode.local/api/home/pins")))
+    expect(initial.status).toBe(200)
+    expect(yield* Effect.promise(() => initial.json())).toEqual({ pins: [] })
+
+    // Subscribe to the event stream so we observe live pin broadcasts.
+    const streamController = new AbortController()
+    const streamResponse = yield* Effect.promise(() =>
+      first(
+        new Request("http://opencode.local/api/event?types=server.home_pins.updated", {
+          signal: streamController.signal,
+        }),
+      ),
+    )
+    expect(streamResponse.status).toBe(200)
+    const reader = streamResponse.body!.getReader()
+    const decoder = new TextDecoder()
+
+    const readNextEvent = async () => {
+      let buffer = ""
+      while (true) {
+        const chunk = await reader.read()
+        if (chunk.done) throw new Error("SSE stream closed unexpectedly")
+        buffer += decoder.decode(chunk.value, { stream: true })
+        const split = buffer.indexOf("\n\n")
+        if (split < 0) continue
+        const frame = buffer.slice(0, split)
+        const line = frame.split("\n").find((item) => item.startsWith("data: "))
+        if (line) return JSON.parse(line.slice("data: ".length)) as { type: string; data: unknown }
+        buffer = buffer.slice(split + 2)
+      }
+    }
+
+    expect((yield* Effect.promise(readNextEvent)).type).toBe("server.connected")
+
+    const pinnedA = yield* Effect.promise(() =>
+      first(new Request("http://opencode.local/api/home/pins/ses_a", { method: "PUT" })),
+    )
+    expect(pinnedA.status).toBe(200)
+    expect(yield* Effect.promise(() => pinnedA.json())).toEqual({ pins: ["ses_a"] })
+    expect(yield* Effect.promise(readNextEvent)).toMatchObject({
+      type: "server.home_pins.updated",
+      data: { pins: ["ses_a"] },
+    })
+
+    // Pinning an already-pinned session is idempotent and keeps pin order.
+    const pinnedADup = yield* Effect.promise(() =>
+      first(new Request("http://opencode.local/api/home/pins/ses_a", { method: "PUT" })),
+    )
+    expect(yield* Effect.promise(() => pinnedADup.json())).toEqual({ pins: ["ses_a"] })
+
+    const pinnedB = yield* Effect.promise(() =>
+      first(new Request("http://opencode.local/api/home/pins/ses_b", { method: "PUT" })),
+    )
+    expect(yield* Effect.promise(() => pinnedB.json())).toEqual({ pins: ["ses_a", "ses_b"] })
+    expect(yield* Effect.promise(readNextEvent)).toMatchObject({
+      type: "server.home_pins.updated",
+      data: { pins: ["ses_a", "ses_b"] },
+    })
+
+    const unpinnedA = yield* Effect.promise(() =>
+      first(new Request("http://opencode.local/api/home/pins/ses_a", { method: "DELETE" })),
+    )
+    expect(yield* Effect.promise(() => unpinnedA.json())).toEqual({ pins: ["ses_b"] })
+    expect(yield* Effect.promise(readNextEvent)).toMatchObject({
+      type: "server.home_pins.updated",
+      data: { pins: ["ses_b"] },
+    })
+
+    streamController.abort()
+    yield* Effect.promise(() => reader.cancel().catch(() => undefined))
+
+    // A fresh server reading the same SQLite database preserves the stored pins.
+    const second = yield* ServerFetch.make(options)
+    const afterRestart = yield* Effect.promise(() => second(new Request("http://opencode.local/api/home/pins")))
+    expect(afterRestart.status).toBe(200)
+    expect(yield* Effect.promise(() => afterRestart.json())).toEqual({ pins: ["ses_b"] })
+  }),
+)
