index 0000000000..11fecb0ccc
--- /dev/null
+++ b/packages/app/src/home/sessions/pins.ts
@@ -0,0 +1,98 @@
+import { Schema } from "effect"
+import { Persistence } from "@/runtime/persistence/schema"
+import { ServerKey } from "@/runtime/server/persistence"
+
+/**
+ * Pinned Home sessions: references only. The session list resolves them against the loaded index and looks up the ones
+ * it no longer holds, so a pin never carries a stale title.
+ */
+export const HomePinsSchema = Persistence.struct({
+  pins: Persistence.array(
+    Persistence.struct({
+      server: ServerKey,
+      sessionId: Schema.String,
+    }),
+  ),
+  /** Servers that have already synced pins at least once; prevents re-uploading cleared pins. */
+  synced: Persistence.array(ServerKey),
+})
+
+export type HomePinsState = typeof HomePinsSchema.Type
+
+export type HomePin = HomePinsState["pins"][number]
+
+export const EMPTY_HOME_PINS: HomePinsState = { pins: [], synced: [] }
+
+export const pinKey = (pin: HomePin) => `${pin.server}\0${pin.sessionId}`
+
+const same = (a: HomePin, b: HomePin) => a.server === b.server && a.sessionId === b.sessionId
+
+export function isPinned(state: HomePinsState, pin: HomePin) {
+  return state.pins.some((item) => same(item, pin))
+}
+
+export function isServerSynced(state: HomePinsState, server: HomePin["server"]) {
+  return state.synced.includes(server)
+}
+
+export function markServerSynced(state: HomePinsState, server: HomePin["server"]): HomePinsState {
+  if (state.synced.includes(server)) return state
+
+  return { ...state, synced: [...state.synced, server] }
+}
+
+export function pin(state: HomePinsState, entry: HomePin): HomePinsState {
+  if (isPinned(state, entry)) return state
+
+  return { ...state, pins: [...state.pins, entry] }
+}
+
+export function unpin(state: HomePinsState, entry: HomePin): HomePinsState {
+  const pins = state.pins.filter((item) => !same(item, entry))
+
+  return pins.length === state.pins.length ? state : { ...state, pins }
+}
+
+export function togglePin(state: HomePinsState, entry: HomePin): HomePinsState {
+  return isPinned(state, entry) ? unpin(state, entry) : pin(state, entry)
+}
+
+export function prunePins(state: HomePinsState, gone: (pin: HomePin) => boolean): HomePinsState {
+  const pins = state.pins.filter((item) => !gone(item))
+
+  return pins.length === state.pins.length ? state : { ...state, pins }
+}
+
+export function pinsForServer(state: HomePinsState, server: string) {
+  return state.pins.filter((item) => item.server === server).map((item) => item.sessionId)
+}
+
+export function replaceServerPins(
+  state: HomePinsState,
+  server: HomePin["server"],
+  sessionIds: readonly string[],
+  options?: { readonly markSynced?: boolean },
+): HomePinsState {
+  const deduped: string[] = []
+  const seen = new Set<string>()
+
+  for (const id of sessionIds) {
+    if (!id || seen.has(id)) continue
+    seen.add(id)
+    deduped.push(id)
+  }
+
+  const current = pinsForServer(state, server)
+  const pinsUnchanged = current.length === deduped.length && current.every((id, index) => id === deduped[index])
+  const shouldSync = options?.markSynced === true && !state.synced.includes(server)
+
+  if (pinsUnchanged && !shouldSync) return state
+
+  const nextPins = pinsUnchanged
+    ? state.pins
+    : [...state.pins.filter((item) => item.server !== server), ...deduped.map((sessionId) => ({ server, sessionId }))]
+
+  const nextSynced = shouldSync ? [...state.synced, server] : state.synced
+
+  return { pins: nextPins, synced: nextSynced }
+}
