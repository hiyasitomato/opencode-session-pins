@@ -0,0 +1,75 @@
+import { describe, expect, test } from "bun:test"
+import {
+  EMPTY_HOME_PINS,
+  isPinned,
+  isServerSynced,
+  markServerSynced,
+  pin,
+  pinKey,
+  pinsForServer,
+  prunePins,
+  replaceServerPins,
+  togglePin,
+  unpin,
+  type HomePin,
+} from "./pins"
+
+// SAFETY: a server key is an opaque branded string; the tests only need distinct values for it.
+const serverKey = (name: string) => name as HomePin["server"]
+
+const ref = (sessionId: string, server = "local"): HomePin => ({ server: serverKey(server), sessionId })
+
+describe("home pins", () => {
+  test("keys a pin by server and session", () => {
+    expect(pinKey(ref("s1"))).toBe(`local\0s1`)
+    expect(pinKey(ref("s1", "remote"))).not.toBe(pinKey(ref("s1")))
+  })
+
+  test("appends in pin order and ignores a duplicate", () => {
+    const once = pin(pin(EMPTY_HOME_PINS, ref("a")), ref("b"))
+
+    expect(once.pins.map((item) => item.sessionId)).toEqual(["a", "b"])
+    expect(pin(once, ref("a"))).toBe(once)
+    expect(isPinned(once, ref("a"))).toBe(true)
+  })
+
+  test("unpins only the matching server", () => {
+    const state = pin(pin(EMPTY_HOME_PINS, ref("a")), ref("a", "remote"))
+
+    expect(unpin(state, ref("a")).pins.map((item) => String(item.server))).toEqual(["remote"])
+    expect(unpin(state, ref("missing"))).toBe(state)
+  })
+
+  test("toggles on then off", () => {
+    const on = togglePin(EMPTY_HOME_PINS, ref("a"))
+
+    expect(isPinned(on, ref("a"))).toBe(true)
+    expect(isPinned(togglePin(on, ref("a")), ref("a"))).toBe(false)
+  })
+
+  test("prunes only pins the caller reports gone", () => {
+    const state = pin(pin(EMPTY_HOME_PINS, ref("keep")), ref("gone"))
+
+    expect(prunePins(state, (item) => item.sessionId === "gone").pins.map((item) => item.sessionId)).toEqual(["keep"])
+    expect(prunePins(state, () => false)).toBe(state)
+  })
+
+  test("lists one server's pins in pin order", () => {
+    const state = pin(pin(pin(EMPTY_HOME_PINS, ref("a")), ref("b", "remote")), ref("c"))
+
+    expect(pinsForServer(state, "local")).toEqual(["a", "c"])
+    expect(pinsForServer(state, "remote")).toEqual(["b"])
+  })
+
+  test("replaces only one server's pins, deduplicates, and preserves object identity on no-op", () => {
+    const base = pin(pin(EMPTY_HOME_PINS, ref("a")), ref("r1", "remote"))
+    const replaced = replaceServerPins(base, serverKey("local"), ["b", "c", "b"], { markSynced: true })
+
+    expect(pinsForServer(replaced, "local")).toEqual(["b", "c"])
+    expect(pinsForServer(replaced, "remote")).toEqual(["r1"])
+    expect(isServerSynced(replaced, serverKey("local"))).toBe(true)
+    expect(isServerSynced(replaced, serverKey("remote"))).toBe(false)
+    expect(replaceServerPins(replaced, serverKey("local"), ["b", "c"], { markSynced: true })).toBe(replaced)
+    expect(markServerSynced(replaced, serverKey("local"))).toBe(replaced)
+  })
+})
