+import { afterEach, beforeEach, describe, expect, setSystemTime, test } from "bun:test"
+import type { SessionInfo } from "@opencode/client/promise"
+import { groupSessions } from "./groups"
+import type { HomeSessionRecord } from "./records"
+
+const language: Parameters<typeof groupSessions>[1] = { t: (key) => key }
+
+const record = (id: string, updated: number): HomeSessionRecord =>
+  // SAFETY: the fixture spells only the fields the grouping reads; the rest of SessionInfo never reaches these tests.
+  ({
+    session: {
+      id,
+      projectID: "p",
+      title: id,
+      time: { created: 1, updated },
+      location: { directory: "/repo" },
+    } as SessionInfo,
+    project: { id: "p", worktree: "/repo" },
+    projectName: "Project",
+  }) as HomeSessionRecord
+
+const at = new Date("2026-11-24T12:00:00")
+
+const now = at.getTime()
+
+describe("groupSessions", () => {
+  beforeEach(() => setSystemTime(at))
+  afterEach(() => setSystemTime())
+
+  test("puts pins first, in pin order, and removes them from date groups", () => {
+    const records = [record("today", now), record("old", now - 3 * 86_400_000), record("pinned", now - 30 * 86_400_000)]
+
+    const groups = groupSessions(records, language, ["pinned", "today"])
+
+    expect(groups.map((group) => group.id)).toEqual(["pinned", "older"])
+    expect(groups[0]?.sessions.map((item) => item.session.id)).toEqual(["pinned", "today"])
+    expect(groups[1]?.sessions.map((item) => item.session.id)).toEqual(["old"])
+  })
+
+  test("omits the pinned group when no pin resolves", () => {
+    const groups = groupSessions([record("today", now)], language, ["gone"])
+
+    expect(groups.map((group) => group.id)).toEqual(["today"])
+  })
+
+  test("keeps a matching pin on top of a filtered list", () => {
+    const groups = groupSessions([record("match", now)], language, ["match"])
+
+    expect(groups.map((group) => group.id)).toEqual(["pinned"])
+    expect(groups[0]?.title).toBe("home.sessions.group.pinned")
+  })
+})
