@@ -0,0 +1,67 @@
+import type { HomeSessionRecord } from "./records"
+
+export type HomeSessionGroupId = "pinned" | "today" | "yesterday" | "older"
+
+export type HomeSessionGroup = {
+  id: HomeSessionGroupId
+  title: string
+  sessions: HomeSessionRecord[]
+}
+
+// Calendar day in the local time zone, comparable as a number.
+function localDay(date: Date) {
+  return date.getFullYear() * 10_000 + date.getMonth() * 100 + date.getDate()
+}
+
+type GroupCopy = {
+  t(
+    key:
+      | "home.sessions.group.pinned"
+      | "home.sessions.group.today"
+      | "home.sessions.group.yesterday"
+      | "home.sessions.group.older"
+      | "sidebar.project.recentSessions",
+  ): string
+}
+
+export function groupSessions(
+  records: readonly HomeSessionRecord[],
+  language: GroupCopy,
+  pinned: readonly string[] = [],
+): HomeSessionGroup[] {
+  const now = new Date()
+  const today = localDay(now)
+  const yesterday = localDay(new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1))
+
+  const byId = new Map(records.map((record) => [record.session.id, record]))
+
+  const pinnedRecords = pinned.flatMap((id) => {
+    const record = byId.get(id)
+
+    return record ? [record] : []
+  })
+
+  const pinnedIDs = new Set(pinnedRecords.map((record) => record.session.id))
+  const rest = records.filter((record) => !pinnedIDs.has(record.session.id))
+
+  const day = (record: HomeSessionRecord) =>
+    localDay(new Date(record.session.time.updated ?? record.session.time.created))
+
+  const todaySessions = rest.filter((record) => day(record) === today)
+  const yesterdaySessions = rest.filter((record) => day(record) === yesterday)
+  const olderSessions = rest.filter((record) => day(record) !== today && day(record) !== yesterday)
+
+  const olderTitle =
+    todaySessions.length === 0 && yesterdaySessions.length === 0
+      ? language.t("sidebar.project.recentSessions")
+      : language.t("home.sessions.group.older")
+
+  return [
+    ...(pinnedRecords.length > 0
+      ? [{ id: "pinned" as const, title: language.t("home.sessions.group.pinned"), sessions: pinnedRecords }]
+      : []),
+    { id: "today" as const, title: language.t("home.sessions.group.today"), sessions: todaySessions },
+    { id: "yesterday" as const, title: language.t("home.sessions.group.yesterday"), sessions: yesterdaySessions },
+    { id: "older" as const, title: olderTitle, sessions: olderSessions },
+  ].filter((group) => group.sessions.length > 0)
+}
