+test("pinning survives selecting another project, and the pin is only hidden while scoped", async ({ page }) => {
+  const other = project({ id: "proj_pin_other", directory: "C:/OpenCode/pin-other", name: "Pin Other" })
+  await mockStressTimeline(page, { projects: [other], worktrees: [] })
+  await seed(page, { usedProjects: { local: [fixture.project.id, other.id] } })
+  await page.goto("/")
+
+  const pinned = page.locator('[data-component="home-session-group"][data-group-id="pinned"]')
+  await row(page, fixture.expected.targetTitle).click({ button: "right" })
+  await page.getByRole("menuitem", { name: "Pin", exact: true }).click()
+  await expect(pinned).toBeVisible()
+
+  const otherRow = page.locator('[data-component="home-project-row"]').filter({ hasText: "Pin Other" })
+  await otherRow.click()
+  await expect(otherRow).toHaveAttribute("data-selected", "")
+  await expect(pinned).toHaveCount(0)
+
+  // Deselecting the project shows the pin again: the scoped miss must never have dropped it.
+  await otherRow.click()
+  await expect(otherRow).not.toHaveAttribute("data-selected", "")
+  await expect(pinned).toBeVisible()
+})
