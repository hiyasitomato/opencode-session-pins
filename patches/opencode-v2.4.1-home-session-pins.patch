+test("pinning a Home session keeps it above Today until it is unpinned", async ({ page }) => {
+  await openHome(page)
+  const target = row(page, fixture.expected.targetTitle)
+  const pinnedHeader = page.locator('[data-component="home-session-group"][data-group-id="pinned"]')
+  // The rows of a group are the container after its header; the header itself only holds the group title.
+  const pinnedRows = page.locator('[data-component="home-session-group"][data-group-id="pinned"] + div')
+  const targetRows = page.locator('[data-component="home-session-row"]').filter({ hasText: fixture.expected.targetTitle })
+
+  await expect(target).toBeVisible()
+  await expect(pinnedHeader).toHaveCount(0)
+
+  await target.click({ button: "right" })
+  await page.getByRole("menuitem", { name: "Pin", exact: true }).click()
+
+  await expect(pinnedHeader).toBeVisible()
+  await expect(pinnedRows).toContainText(fixture.expected.targetTitle)
+  await expect(targetRows).toHaveCount(1)
+
+  await page.reload()
+  await expect(pinnedRows).toContainText(fixture.expected.targetTitle)
+  await expect(targetRows).toHaveCount(1)
+
+  await row(page, fixture.expected.targetTitle).click({ button: "right" })
+  await page.getByRole("menuitem", { name: "Unpin", exact: true }).click()
+
+  await expect(pinnedHeader).toHaveCount(0)
+  await expect(targetRows).toHaveCount(1)
+
+  await row(page, fixture.expected.targetTitle).click({ button: "right" })
+  await page.getByRole("menuitem", { name: "Pin", exact: true }).click()
+  await expect(pinnedHeader).toBeVisible()
+
+  await row(page, fixture.expected.targetTitle).click({ button: "right" })
+  await page.getByRole("menuitem", { name: "Delete…" }).click()
+  const dialog = page.getByRole("dialog")
+
+  const removed = await holdRoute(page, (url) => url.pathname.endsWith(`/session/${fixture.targetID}`), {
+    method: "DELETE",
+  })
+
+  await dialog.getByRole("button", { name: "Delete session" }).click()
+  await removed.arrived
+  removed.release()
+
+  await expect(pinnedHeader).toHaveCount(0)
+  await expect(targetRows).toHaveCount(0)
+})
