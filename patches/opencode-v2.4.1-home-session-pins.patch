+import { describe, expect, test } from "bun:test"
+import type { SessionInfo } from "@opencode/client/promise"
+import { pinLookupDecision } from "./pin-lookup"
+
+// SAFETY: the decision reads only whether a session is present, never its fields.
+const session = { id: "ses_1" } as SessionInfo
+
+describe("pinLookupDecision", () => {
+  test("resolves a session the live context answered with", () => {
+    expect(pinLookupDecision({ current: true, session })).toBe("resolved")
+  })
+
+  test("drops a pin only when the live context says the session is gone", () => {
+    expect(pinLookupDecision({ current: true, session: undefined })).toBe("gone")
+  })
+
+  test("keeps the pin when the run no longer belongs to the focused server", () => {
+    expect(pinLookupDecision({ current: false, session: undefined })).toBe("retry")
+    expect(pinLookupDecision({ current: false, session })).toBe("retry")
+  })
+})
