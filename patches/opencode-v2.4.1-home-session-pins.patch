+test("Home session pins load from the server and reflect live updates from another device", async ({ page }) => {
+  const first = session({
+    id: "ses_sync_first",
+    directory: fixture.directory,
+    projectID: fixture.project.id,
+    title: "Pinned on desktop",
+    created: T0,
+  })
+
+  const second = session({
+    id: "ses_sync_second",
+    directory: fixture.directory,
+    projectID: fixture.project.id,
+    title: "Pinned from phone",
+    created: T0 - 1_000,
+  })
+
+  const server = await mockOpenCodeServer(page, {
+    directory: fixture.directory,
+    project: fixture.project,
+    provider: NO_PROVIDER,
+    sessions: [first, second],
+    homePins: [first.id],
+    pageMessages: () => ({ items: [] }),
+  })
+
+  await seed(page, { usedProjects: { local: [fixture.project.id] } })
+  await page.goto("/")
+
+  const pinnedRows = page.locator('[data-component="home-session-group"][data-group-id="pinned"] + div')
+  await expect(pinnedRows).toContainText(first.title)
+  await expect(pinnedRows).not.toContainText(second.title)
+
+  // Another connected client (e.g. phone browser) pins a second session.
+  await server.push([
+    {
+      id: "evt_remote_pin_add",
+      created: T0 + 1_000,
+      type: "server.home_pins.updated",
+      data: { pins: [first.id, second.id] },
+    },
+  ])
+  await expect(pinnedRows).toContainText(first.title)
+  await expect(pinnedRows).toContainText(second.title)
+
+  // Another client unpins all sessions.
+  await server.push([
+    {
+      id: "evt_remote_pin_clear",
+      created: T0 + 2_000,
+      type: "server.home_pins.updated",
+      data: { pins: [] },
+    },
+  ])
+  await expect(page.locator('[data-component="home-session-group"][data-group-id="pinned"]')).toHaveCount(0)
+})
