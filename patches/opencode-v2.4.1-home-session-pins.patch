@@ -0,0 +1,13 @@
+import type { SessionInfo } from "@opencode/client/promise"
+
+export type PinLookupDecision = "resolved" | "gone" | "retry"
+
+/**
+ * Only a live context that answers the session does not exist drops a pin. No context, a run that no longer matches the
+ * focused server, and a failed request all keep it for a later attempt.
+ */
+export function pinLookupDecision(input: { current: boolean; session: SessionInfo | undefined }): PinLookupDecision {
+  if (!input.current) return "retry"
+
+  return input.session ? "resolved" : "gone"
+}
