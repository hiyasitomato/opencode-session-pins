+import { ClientError } from "@opencode/client/promise"
+import { Predicate } from "effect"
+import { createEffect, createMemo, createSignal, onCleanup, untrack } from "solid-js"
+import { Persist, persisted } from "@/runtime/persistence/storage"
+import type { ServerSDK } from "@/runtime/server/client"
+import type { ServerConnection } from "@/runtime/server/registry"
+import { HOME_SESSIONS_FETCH_TIMEOUT_MS } from "./load-machine"
+import {
+  EMPTY_HOME_PINS,
+  HomePinsSchema,
+  isPinned,
+  isServerSynced,
+  markServerSynced,
+  pinsForServer,
+  prunePins,
+  replaceServerPins,
+  togglePin,
+} from "./pins"
+import {
+  INITIAL_HOME_PIN_SYNC_STATE,
+  transitionHomePinSync,
+  type HomePinSyncEffect,
+  type HomePinSyncEvent,
+} from "./pin-sync-machine"
+
+function isUnsupportedPinError(cause: unknown) {
+  if (!(cause instanceof ClientError) || cause.reason !== "UnexpectedStatus") return false
+
+  if (!Predicate.isObject(cause.cause) || !Predicate.hasProperty(cause.cause, "status")) return false
+
+  return cause.cause.status === 404 || cause.cause.status === 405 || cause.cause.status === 501
+}
+
+export function createGlobalHomePins() {
+  const [state, setState, , ready] = persisted(Persist.global("home.pins"), HomePinsSchema, EMPTY_HOME_PINS)
+
+  return {
+    ready,
+    ids: (server: ServerConnection.Key) => pinsForServer(state, server),
+    isPinned: (server: ServerConnection.Key, sessionId: string) => isPinned(state, { server, sessionId }),
+    isSynced: (server: ServerConnection.Key) => isServerSynced(state, server),
+    markSynced: (server: ServerConnection.Key) => setState((current) => markServerSynced(current, server)),
+    replace: (server: ServerConnection.Key, sessionIds: readonly string[], options?: { readonly markSynced?: boolean }) =>
+      setState((current) => replaceServerPins(current, server, sessionIds, options)),
+    toggle: (server: ServerConnection.Key, sessionId: string) => {
+      const ref = { server, sessionId }
+      const wasPinned = isPinned(state, ref)
+
+      setState((current) => togglePin(current, ref))
+
+      return { wasPinned }
+    },
+    prune: (server: ServerConnection.Key, sessionIds: readonly string[]) => {
+      if (sessionIds.length === 0) return
+      setState((current) =>
+        prunePins(current, (item) => item.server === server && sessionIds.includes(item.sessionId)),
+      )
+    },
+  }
+}
+
+export type GlobalHomePins = ReturnType<typeof createGlobalHomePins>
+
+export function createServerHomePins(input: {
+  readonly key: ServerConnection.Key
+  readonly sdk: ServerSDK
+  readonly store: GlobalHomePins
+}) {
+  const [syncState, setSyncState] = createSignal(INITIAL_HOME_PIN_SYNC_STATE)
+  const controllers = new Map<number, AbortController>()
+
+  const dispatch = (event: HomePinSyncEvent) =>
+    untrack(() => {
+      const previous = syncState()
+      const next = transitionHomePinSync(previous, event)
+
+      if (next.state !== previous) setSyncState(next.state)
+      next.effects.forEach(runEffect)
+    })
+
+  function runEffect(effect: HomePinSyncEffect) {
+    if (effect.type === "fetch.cancel" || effect.type === "mutate.cancel") {
+      controllers.get(effect.attempt)?.abort()
+      controllers.delete(effect.attempt)
+
+      return
+    }
+
+    if (effect.type === "mark.synced") {
+      input.store.markSynced(effect.server)
+
+      return
+    }
+
+    if (effect.type === "apply") {
+      input.store.replace(effect.server, effect.pins, { markSynced: effect.markSynced })
+
+      return
+    }
+
+    const attempt = effect.attempt
+    const controller = new AbortController()
+
+    controllers.set(attempt, controller)
+
+    const signal =
+      "any" in AbortSignal && "timeout" in AbortSignal
+        ? AbortSignal.any([controller.signal, AbortSignal.timeout(HOME_SESSIONS_FETCH_TIMEOUT_MS)])
+        : controller.signal
+
+    if (effect.type === "fetch") {
+      void input.sdk.api.server.homePins({ signal }).then(
+        (result) => {
+          controllers.delete(attempt)
+          dispatch({
+            type: "fetch.succeeded",
+            attempt,
+            pins: result.pins,
+            localPins: input.store.ids(effect.server),
+            synced: input.store.isSynced(effect.server),
+          })
+        },
+        (cause: unknown) => {
+          controllers.delete(attempt)
+          dispatch({ type: isUnsupportedPinError(cause) ? "fetch.unsupported" : "fetch.failed", attempt })
+        },
+      )
+
+      return
+    }
+
+    const request =
+      effect.mutation.op === "pin"
+        ? input.sdk.api.server.pinHomeSession({ sessionID: effect.mutation.sessionId }, { signal })
+        : input.sdk.api.server.unpinHomeSession({ sessionID: effect.mutation.sessionId }, { signal })
+
+    void request.then(
+      (result) => {
+        controllers.delete(attempt)
+        dispatch({ type: "mutation.succeeded", attempt, pins: result.pins })
+      },
+      (cause: unknown) => {
+        controllers.delete(attempt)
+        dispatch({ type: isUnsupportedPinError(cause) ? "mutation.unsupported" : "mutation.failed", attempt })
+      },
+    )
+  }
+
+  createEffect(() => {
+    const connected = input.store.ready() && input.sdk.connection.status() === "connected"
+
+    untrack(() => dispatch({ type: "server.changed", server: input.key, connected }))
+  })
+
+  onCleanup(
+    input.sdk.event.on("server.home_pins.updated", (event) => {
+      dispatch({ type: "remote.updated", server: input.key, pins: event.data.pins })
+    }),
+  )
+
+  onCleanup(() => dispatch({ type: "disposed" }))
+
+  const ids = createMemo(() => input.store.ids(input.key))
+
+  return {
+    ids,
+    isPinned: (sessionId: string) => input.store.isPinned(input.key, sessionId),
+    toggle: (sessionId: string) => {
+      const { wasPinned } = input.store.toggle(input.key, sessionId)
+
+      dispatch({ type: "mutation.requested", server: input.key, op: wasPinned ? "unpin" : "pin", sessionId })
+
+      return { wasPinned }
+    },
+    prune: (sessionIds: readonly string[]) => {
+      const present = sessionIds.filter((id) => input.store.isPinned(input.key, id))
+
+      if (present.length === 0) return
+      input.store.prune(input.key, present)
+      present.forEach((sessionId) => dispatch({ type: "mutation.requested", server: input.key, op: "unpin", sessionId }))
+    },
+  }
+}
+
+export type ServerHomePins = ReturnType<typeof createServerHomePins>
